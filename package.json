{
  "name": "event-horizon",
  "version": "0.1.0",
  "description": "Event Horizon — a Singularity tool. Desktop client for coding agents that speak the Agent Client Protocol.",
  "main": "./out/main/index.js",
  "//exports": "Consumed as source: the host's bundler compiles the TS/TSX, so types resolve natively and there is no build step to keep in sync. Works today for a workspace/monorepo dependency or a git dependency. Publishing to npm would additionally need a lib build emitting JS + .d.ts.",
  "exports": {
    "./renderer": "./src/renderer/src/index.ts",
    "./renderer/style.css": "./src/renderer/src/styles/index.css",
    "./core": "./src/main/core.ts",
    "./shared": "./src/shared/ipc.ts",
    "./shared/acp": "./src/shared/acp.ts",
    "./shared/context": "./src/shared/contextInfo.ts",
    "./providers/singularity-flow": "./src/main/providers/singularityFlow.ts",
    "./contract": "./src/main/contract.ts"
  },
  "files": [
    "src",
    "out",
    "electron.vite.config.ts",
    "tsconfig*.json"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "author": "Ashok Raj",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "setup": "bash scripts/install.sh",
    "build": "npm run build:harness && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --target=node22 --outfile=out/smoke.cjs --log-level=error && node out/smoke.cjs",
    "skills:check": "esbuild scripts/skills-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --alias:@shared=./src/shared --outfile=out/skills-check.mjs --log-level=error && node out/skills-check.mjs",
    "context:check": "esbuild scripts/context-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/context-check.mjs --log-level=error && node out/context-check.mjs",
    "profile:check": "esbuild scripts/profile-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/profile-check.mjs --log-level=error && node out/profile-check.mjs",
    "index:check": "esbuild scripts/index-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/index-check.mjs --log-level=error && node out/index-check.mjs",
    "outline:check": "esbuild scripts/outline-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/outline-check.mjs --log-level=error && node out/outline-check.mjs",
    "attach:check": "esbuild scripts/attach-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/attach-check.mjs --log-level=error && node out/attach-check.mjs",
    "guard": "sh scripts/guard-coupling.sh",
    "embed:check": "esbuild scripts/embed-check.ts --bundle --platform=node --format=esm --target=node22 --alias:@shared=./src/shared --external:typescript --outfile=out/embed-check.mjs --log-level=error && node out/embed-check.mjs",
    "check": "npm run guard && npm run install:check && npm run typecheck && npm run contract:check && npm run context:check && npm run embed:check && npm run skills:check && npm run smoke && npm run outline:check && npm run index:check && npm run persist:check && npm run policy:check && npm run gate:check && npm run workflow:check && npm run compiler:check && npm run constraint:check && npm run harness:check && npm run endpoints:check && npm run capability:check && npm run ledger:check && npm run provider:check && npm run profile:check && npm run attach:check",
    "dist": "electron-vite build && electron-builder",
    "provider:check": "esbuild scripts/provider-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/provider-check.mjs --log-level=error && node out/provider-check.mjs",
    "contract:check": "esbuild scripts/contract-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/contract-check.mjs --log-level=error && node out/contract-check.mjs",
    "persist:check": "esbuild scripts/persist-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/persist-check.mjs --log-level=error && node out/persist-check.mjs",
    "policy:check": "esbuild scripts/policy-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/policy-check.mjs --log-level=error && node out/policy-check.mjs",
    "install:check": "bash scripts/install-check.sh",
    "gate:check": "esbuild scripts/gate-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/gate-check.mjs --log-level=error && node out/gate-check.mjs",
    "workflow:check": "esbuild scripts/workflow-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/workflow-check.mjs --log-level=error && node out/workflow-check.mjs",
    "compiler:check": "esbuild scripts/compiler-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/compiler-check.mjs --log-level=error && node out/compiler-check.mjs",
    "constraint:check": "esbuild scripts/constraint-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/constraint-check.mjs --log-level=error && node out/constraint-check.mjs",
    "build:harness": "esbuild src/harness/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=out/harness/index.mjs --log-level=error",
    "harness:check": "npm run build:harness && esbuild scripts/harness-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/harness-check.mjs --log-level=error && node out/harness-check.mjs",
    "endpoints:check": "esbuild scripts/endpoints-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/endpoints-check.mjs --log-level=error && node out/endpoints-check.mjs",
    "capability:check": "esbuild scripts/capability-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/capability-check.mjs --log-level=error && node out/capability-check.mjs",
    "capability": "esbuild scripts/capability-cli.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/capability-cli.mjs --log-level=error && node out/capability-cli.mjs",
    "ledger:check": "esbuild scripts/ledger-check.ts --bundle --platform=node --format=esm --target=node22 --external:typescript --outfile=out/ledger-check.mjs --log-level=error && node out/ledger-check.mjs"
  },
  "dependencies": {
    "diff": "^7.0.0",
    "js-yaml": "^4.3.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "highlight.js": "^11.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-virtuoso": "^4.18.11",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "ai.singularity.event-horizon",
    "productName": "Event Horizon",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    }
  }
}
